# Templated by release.yml, then pushed to KING-MASTER2012/homebrew-CoreForge
# as Formula/coreforge.rb. __VERSION__, __SHA256_ARM64__, and
# __SHA256_X86_64__ are substituted with the release version and the
# sha256 sums of coreforge-aarch64-apple-darwin.tar.gz /
# coreforge-x86_64-apple-darwin.tar.gz before pushing.
class Coreforge < Formula
  desc "Coreverse Engine build system (CLI + GUI)"
  homepage "https://github.com/KING-MASTER2012/CoreForge"
  version "__VERSION__"
  license "GPL-3.0-only"

  on_macos do
    on_arm do
      url "https://github.com/KING-MASTER2012/CoreForge/releases/download/v__VERSION__/coreforge-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA256_ARM64__"
    end
    on_intel do
      url "https://github.com/KING-MASTER2012/CoreForge/releases/download/v__VERSION__/coreforge-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA256_X86_64__"
    end
  end

  def install
    bin.install "coreforge"
    bin.install "coreforge-gui"
  end

  test do
    system "#{bin}/coreforge", "--version"
  end
end
